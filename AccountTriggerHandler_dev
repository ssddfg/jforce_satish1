    public static void updatePayToForNewAccounts(List<Account> newAccounts, Boolean isBeforeInsert){
        
        Set<String> panSet = new Set<String>(); 
        for (Account acc: newAccounts){
            if(acc.PAN__c != null && acc.Registered__c){
                panSet.add(acc.PAN__c);
            }
        }
        
        if(panSet.isEmpty()) return;
        
        List<Account> existingAcc;
        if (isBeforeInsert) {
            existingAcc = [SELECT Id, PAN__c, Pay_to__c, Registered__c FROM Account WHERE Registered__c = TRUE AND PAN__c IN :panSet AND Pay_to__c != NULL
                           ORDER BY CreatedDate DESC];
        } else {
            existingAcc = [SELECT Id, PAN__c, Pay_to__c, Registered__c FROM Account WHERE Registered__c = TRUE AND PAN__c IN :panSet AND Pay_to__c != NULL 
                           AND Id NOT IN :newAccounts ORDER BY CreatedDate DESC];
        }
        
        Map<String, Account> existingAccMap = new Map<String, Account>();
        for (Account acc : existingAcc) {
            if (!existingAccMap.containsKey(acc.PAN__c)) {
                existingAccMap.put(acc.PAN__c, acc);
            }
        }
        List<Account> accountsToUpdate = new List<Account>();
        
        for (Account acc : newAccounts) { 
            String newPayto = existingAccMap.containsKey(acc.PAN__c) ? existingAccMap.get(acc.PAN__c).Pay_to__c : 'JOPL Nodal'; 
            
            if(isBeforeInsert && acc.Pay_to__c != newPayto){
                acc.Pay_to__c =newPayto;
            }
            
            if(!isBeforeInsert){
                accountsToUpdate.add(new Account(Id = acc.Id, Pay_to__c = newPayTo));
            }           
        }
        if (!accountsToUpdate.isEmpty() && !isBeforeInsert) {
            update accountsToUpdate;
        }
    }
    
    public static void updatePayToForExisitngAccounts(List<Account> newAccount, Map<Id, Account> oldMap){ 
        if (hasRunUpdatePayTo) {
            return; 
        }
        hasRunUpdatePayTo = true;// SF-5725
        Set<String> panSet = new Set<String>();
        Map<String, String> panAndpayTo = new Map<String, String>();
        List<Account> AccList = new List<Account>();
        Map<String, String> existingAccountMap = new Map<String, String>();
        
        for(Account acc : newAccount){
            if(acc.Registered__c != oldMap.get(acc.Id).Registered__c && acc.PAN__c != null){
                AccList.add(acc);  
            }
            else if(acc.PAN__c != null && acc.Pay_to__c != oldMap.get(acc.Id).Pay_to__c){
                panAndpayTo.put(acc.PAN__c,acc.Pay_to__c);
            }
        }
        
        if(!AccList.isEmpty()){
            AccountTriggerhandler.updatePayToForNewAccounts(AccList,false);
            return;
        }


        if(panAndpayTo.isEmpty()) return; 
        List<Account> accountToUpdate = [SELECT Id, PAN__c, Pay_to__c,Registered__c FROM Account WHERE PAN__c IN :panAndpayTo.keyset() AND Registered__c = TRUE
                                         AND Id NOT IN : newAccount];
        System.debug('ExistingAccountList::'+ accountToUpdate);
        List<Account> updatedAccounts = new List<Account>(); 
        
        For(Account ExistAcc : accountToUpdate){
            existingAccountMap.put(ExistAcc.PAN__c, ExistAcc.Pay_to__c);
            if ( panAndpayTo.get(existAcc.PAN__c) != null && panAndpayTo.get(existAcc.PAN__c) != ExistAcc.Pay_to__c) { 
                ExistAcc.Pay_to__c = panAndpayTo.get(ExistAcc.PAN__c); 
                updatedAccounts.add(existAcc);   
            }
        }
        System.debug('Updated AcocuntList::'+ updatedAccounts);
        
        if (updatedAccounts.isEmpty()) return;
        
        if(FeatureManagement.checkPermission('Enable_Pay_to_Access')){
            update updatedAccounts;
        } 
        else{
            for(Account acc : newAccount){
                if(acc.PAN__c != null && existingAccountMap.containsKey(acc.PAN__c)){
                    acc.addError('You do not have access to edit');
                }
            }
        }       
    }
