    public static void updateVAN(List<Account> newAccountList, Map<Id, Account> oldMap){



        list<string> gstinList = new list<string>();
        Id distributorRecordTypeId = Schema.SObjectType.Account.getRecordTypeInfosByDeveloperName().get('Distributor').getRecordTypeId();
        list<account> filteredAccounts = new list<account>();
        
        for(account acc : newAccountList){
            
            if (oldMap != null && oldMap.containsKey(acc.Id)){
                // Trigger context is before update
                Account oldAcc = oldMap.get(acc.Id);
                
                if( ( (oldAcc.Registered__c == false && acc.Registered__c == true) || (acc.Registered__c == true && (oldAcc.Pay_to__c != acc.Pay_to__c || oldAcc.Nodal_Bank_Account__c != acc.Nodal_Bank_Account__c || oldAcc.Non_Nodal_Bank_Account__c != acc.Non_Nodal_Bank_Account__c ))) //for registered accounts //SF-3921-added Non_Nodal_Bank_Account__c

                   || ( acc.Registered__c == false && acc.RecordTypeId == distributorRecordTypeId && (oldAcc.Pay_to__c != acc.Pay_to__c || oldAcc.Nodal_Bank_Account__c != acc.Nodal_Bank_Account__c  || oldAcc.Non_Nodal_Bank_Account__c != acc.Non_Nodal_Bank_Account__c )) //for dist accounts
                  ){
                      gstinList.add(acc.GST__c);
                      filteredAccounts.add(acc);
                  }
            }
            else if (acc.Registered__c == true || acc.RecordTypeId == distributorRecordTypeId){
                // Trigger context is after insert
                gstinList.add(acc.GST__c);
                filteredAccounts.add(acc);
            }
        }//for end
        
        if(gstinList != null && !gstinList.isEmpty() && gstinList.size() > 0 && gstinList[0] != null ){


            map<string,string> gstVanMap = JSW_VANGenerator.generateUniqueVANs(gstinList);
            JSW_VANGenerator.tagVanToAccounts(gstVanMap,filteredAccounts);
        }

        
    }
