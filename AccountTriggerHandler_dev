    public static void syncAnnualTurnoverToOpportunity(List<Account> newList, Map<Id, Account> oldMap) {
        if (Opportunity_Trg_Handler.annualTurnoverSyncRunning) return;

        Map<Id, String> turnoverByAccountId = new Map<Id, String>();

        for (Account acc : newList) {
            Account oldAcc = oldMap.get(acc.Id);
            if (acc.Annual_Turnover_Cr__c != oldAcc.Annual_Turnover_Cr__c) {
                turnoverByAccountId.put(acc.Id, acc.Annual_Turnover_Cr__c);
            }
        }

        if (turnoverByAccountId.isEmpty()) return;

        List<Opportunity> oppsToUpdate = [SELECT Id, AccountId, Annual_Turnover_Cr__c FROM Opportunity WHERE AccountId IN :turnoverByAccountId.keySet()
            							  AND RecordType.DeveloperName = 'Credit' AND IsClosed = false];

        for (Opportunity opp : oppsToUpdate) {
            opp.Annual_Turnover_Cr__c = turnoverByAccountId.get(opp.AccountId);
        }

        if (!oppsToUpdate.isEmpty()) {
            Opportunity_Trg_Handler.annualTurnoverSyncRunning = true;
            AccountTriggerHandler.accountTriggerStop = true;
            update oppsToUpdate;
            AccountTriggerHandler.accountTriggerStop = false;
            Opportunity_Trg_Handler.annualTurnoverSyncRunning = false;
        }
    }
    
