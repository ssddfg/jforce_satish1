    public void accountPreventDuplicate(List<Account> triggerNew,Map<Id,Account> oldMap){
        Id manufacturingRecordType = Schema.SObjectType.Account.getRecordTypeInfosByDeveloperName().get('Business_Account').getRecordTypeId();
        Id constructRecordType = Schema.SObjectType.Account.getRecordTypeInfosByDeveloperName().get('MSME_Construct_Account').getRecordTypeId();

        //Added for SF-2405
        Id retailRecordType = Schema.SObjectType.Account.getRecordTypeInfosByDeveloperName().get('Retail').getRecordTypeId();
        //SF-2632
        Id DistributorRecordType = Schema.SObjectType.Account.getRecordTypeInfosByDeveloperName().get('Distributor').getRecordTypeId();
        Id Ship_to_AccountRecordType = Schema.SObjectType.Account.getRecordTypeInfosByDeveloperName().get('Ship_to_Account').getRecordTypeId();

        system.debug('Duplicate prevention');
        Set<String> setGST = new Set<String>();
        Set<String> setCTID = new Set<String>();
        Set<String> setEmail = new Set<String>();
        Set<String> setPhone = new Set<String>();
        for(Account acc: triggerNew){
            if(acc.AccountSource != 'JSW One' && (acc.RecordTypeId == Ship_to_AccountRecordType || acc.RecordTypeId == manufacturingRecordType || acc.RecordTypeId == constructRecordType ||  acc.RecordTypeId == retailRecordType || acc.RecordTypeId == DistributorRecordType )){
                if(acc.GST__c != oldMap.get(acc.Id).GST__c){
                    setGST.add(acc.GST__c);
                }
                if(acc.Customer_Id_CT__c != oldMap.get(acc.Id).Customer_Id_CT__c){
                    setCTID.add(acc.Customer_Id_CT__c);
                }
                if(acc.Email__c != oldMap.get(acc.Id).Email__c){
                    setEmail.add(acc.Email__c);
                }
                if(acc.Company_Phone__c != oldMap.get(acc.Id).Company_Phone__c && acc.Company_Phone__c != null && acc.Company_Phone__c.length() >= 10){
                        setPhone.add('%'+acc.Company_Phone__c.right(10)+'%');
                }
            }
        }
        system.debug('setPhone='+setPhone);
        
        Map<String, List<Account>> CTDMAP = new Map<String, List<Account>>(); // CTD MAP
        Map<String, List<Account>> GSTMAP = new Map<String, List<Account>>(); // GST MAP
