    public void jswMoengageEvent(List<Account> triggerNew,Map<Id,Account> oldMap){

        Id msmeRecordTypeId = Schema.SObjectType.Account.getRecordTypeInfosByDeveloperName().get('Business_Account').getRecordTypeId();
        
        for(Account objAcc : triggerNew){
            
            if(objAcc.Registered__c == true || objAcc.RecordTypeId != msmeRecordTypeId){
                continue;
            }
            Boolean isValidRec = false;
            
            MoengageWrapEvent objEventWrap = new MoengageWrapEvent();
            objEventWrap.type = 'event';
            objEventWrap.customer_id = objAcc.Account_Sf_ID__c;
            
            MoengageWrapEvent.cls_attributes eventAttr = new MoengageWrapEvent.cls_attributes();
            eventAttr.Accountownername = objAcc.Account_Owner_Name__c; // Set account owner name
            
            List<MoengageWrapEvent.cls_actions> aclist = new List<MoengageWrapEvent.cls_actions>();
            
            MoengageWrapEvent.cls_actions ac = new MoengageWrapEvent.cls_actions();
            
            if (objAcc.Account_Status__c == 'Qualification Pending' && objAcc.Number_of_Calls_Attempted__c != oldMap.get(objAcc.Id).Number_of_Calls_Attempted__c && objAcc.Number_of_Calls_Answered__c == oldMap.get(objAcc.Id).Number_of_Calls_Answered__c){                    
                ac.action = 'MISSED-CALL-UNQ';
                ac.attributes = eventAttr;
                aclist.add(ac);
                
                objEventWrap.actions = aclist;


                
                isValidRec = true;
            }
            
            if(objAcc.Account_Status__c == 'Qualified Not Registered' && oldMap.get(objAcc.Id).Account_Status__c == 'Qualification Pending'){
                ac.action = 'SHARE-REGISTRATION-LINK';
                ac.attributes = eventAttr;
                aclist.add(ac);
                
                objEventWrap.actions = aclist;
                
                isValidRec = true;
            }
            
            if(isValidRec && !System.isBatch() && !System.isFuture()){// added System.isFuture and isBatch on 13th May 2025 to fix nested batch issue
                String eventPayload = JSON.serialize(objEventWrap);
                MoengageAPI.eventCreation(eventPayload,objAcc.Id);                
            }
            
        }
        
    }

