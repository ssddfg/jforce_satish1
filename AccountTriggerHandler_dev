/**
* Method for early knockoff processing when Account records are updated.
*
* This method is triggered when Account records are updated. It identifies
* Accounts whose Early Knock Off stage has changed from "Pending" to "Approved,"
* creates a request wrapper, and calls the JSW_EarlyKnockoff class to process
* these records.
*
* @param newAccountMap A map of Id to the updated Account records.
* @param oldAccountMap A map of Id to the previous Account records.
* @see SF-1311 (https://jswone.atlassian.net/browse/SF-1311)
* @see https://jswone.atlassian.net/browse/SF-2739 | Added Early zohoRequestList wrapper |Israr Alam 
*/
    public void earlyknockOff(Map<Id, Account> newAccountMap, Map<Id, Account> oldAccountMap) {
        
        // Create a list to store the request wrapper
        List<JSW_EarlyKnockoff.EarlyKnockoffWrapper> requestList = new List<JSW_EarlyKnockoff.EarlyKnockoffWrapper>();
        
        // Iterate through the updated Account records
        for (Account objAccount : newAccountMap.values()) {
            // Check if the Early Knock Off stage has changed from "Pending" to "Approved"
            if (objAccount.JSW_Early_Knock_Off_Stage__c == 'Approved' &&
                oldAccountMap.get(objAccount.Id).JSW_Early_Knock_Off_Stage__c == 'Pending') {
                    JSW_EarlyKnockoff.EarlyKnockoffWrapper request = new JSW_EarlyKnockoff.EarlyKnockoffWrapper();
                    request.accId = objAccount.Id;
                    request.gstin = objAccount.GST__c;
                    request.email = objAccount.Email__c;
                    requestList.add(request);
                }
        }
        
        // If there are matching records, call the JSW_EarlyKnockoff class
        if (!requestList.isEmpty()) {
            // Serialize the requestList to JSON
            String requestListJSON = JSON.serialize(requestList);
            
            // Call the future method in the JSW_EarlyKnockoff class
            JSW_EarlyKnockoff.earlyknockoffrequest(requestListJSON, JSON.serialize(newAccountMap));
        }
    }
